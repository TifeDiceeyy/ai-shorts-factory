{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "brief.schema.json",
  "title": "Research Brief",
  "type": "object",
  "required": ["topic", "safety_class", "claims"],
  "additionalProperties": false,
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "safety_class": { "type": "string", "enum": ["green", "yellow", "red"] },
    "caution": { "type": "string" },
    "concept": { "type": "string" },
    "angle": { "type": "string" },
    "chosen_hook": { "type": "string" },
    "payoff": { "type": "string" },
    "claims": {
      "type": "array",
      "minItems": 4,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "claim", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^claim-[0-9]{2}$" },
          "claim": { "type": "string", "minLength": 10 },
          "source": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
