{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "script.schema.json",
  "title": "Scene Script",
  "type": "object",
  "required": ["topic", "language", "visual_style", "scenes"],
  "additionalProperties": false,
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "visual_style": { "type": "string", "minLength": 1 },
    "mascot_id": { "type": "string" },
    "caption_style": { "type": "string" },
    "caution_text": { "type": ["string", "null"] },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["narration", "caption", "duration", "visual_prompt", "source_claim_id"],
        "additionalProperties": false,
        "properties": {
          "narration": { "type": "string", "minLength": 1 },
          "caption": { "type": "string", "minLength": 1, "maxLength": 90 },
          "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 15 },
          "visual_prompt": { "type": "string", "minLength": 1 },
          "source_claim_id": { "type": "string", "pattern": "^claim-[0-9]{2}$" },
          "camera": { "type": "string", "minLength": 1 },
          "sfx": { "type": ["string", "null"] },
          "mascot_role": { "type": "string" },
          "mascot_emotion": { "type": "string" },
          "action": { "type": "string" },
          "props": { "type": ["string", "null"] },
          "layout": { "type": "string" },
          "scene_type": { "type": "string" },
          "fx": { "type": ["string", "null"] },
          "stickers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "visual_prompt", "appear_at", "entrance", "idle", "position"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^stk-[0-9]{3}$" },
                "visual_prompt": { "type": "string", "minLength": 1 },
                "appear_at": { "type": "number", "minimum": 0 },
                "entrance": {
                  "type": "string",
                  "enum": ["fade_in", "slide_up", "slide_left"]
                },
                "idle": {
                  "type": "string",
                  "enum": ["float", "flicker", "drift", "spin", "hold", "breathe"]
                },
                "position": {
                  "type": "string",
                  "enum": ["center", "top_left", "top_right", "bottom_left", "bottom_right"]
                },
                "uses_hero": { "type": "boolean" },
                "label": { "type": "string", "maxLength": 24 },
                "trigger_words": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "maxItems": 6
                },
                "is_label": { "type": "boolean" },
                "parent_id": { "type": "string", "pattern": "^stk-[0-9]{3}$" }
              }
            }
          }
        }
      }
    }
  }
}
