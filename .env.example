# AI Shorts Factory configuration
# Copy to .env and fill in. Anything left unset (or set to "stub") uses the
# free, local, zero-network stub provider — no paid API call is ever made
# unless the corresponding *_PROVIDER var below is explicitly set to a real
# provider name AND the matching credential env var is present.

# --- Inputs from CLAUDE.md §1 ---
BOOK_FILE=
OUTPUT_LANGUAGE=English
VISUAL_STYLE=illustrated realism, diagram-forward, post-collapse workshop aesthetic

# Leave BUDGET_CAP_USD unset until you've deliberately decided a number.
# It intentionally has NO default value here: if it did, a plain
# `cp .env.example .env` would silently count as budget approval for any
# real provider below. Uncomment and set a real number only when you mean it:
# BUDGET_CAP_USD=2.00

# --- Provider selection ---
# Values: "stub" (default, free, local, deterministic) | a real provider name
# once approved (e.g. "anthropic", "elevenlabs", "fal", "tavily").
LLM_PROVIDER=stub
LLM_MODEL=
TTS_PROVIDER=stub
TTS_VOICE=
IMAGE_PROVIDER=stub
IMAGE_MODEL=
MUSIC_SFX_SOURCE=

# Search has no stub option — a fake search result can't produce a real,
# checkable citation, which is the entire point of Phase 1 retrieval. Leave
# SEARCH_PROVIDER unset until you have a real key; retrieval simply refuses
# to run until then.
SEARCH_PROVIDER=
SEARCH_MODEL=

# --- Credentials (only read if the matching *_PROVIDER above is non-stub) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
SEARCH_API_KEY=

# --- Phase 5: YouTube upload ---
# From Google Cloud Console: create an OAuth client (type "Desktop app"),
# enable the YouTube Data API v3, download the client secrets JSON. Leave
# unset and Phase 5 publishing refuses to run — no stub, a fake upload can't
# confirm a real disclosure flag from a real API response.
YOUTUBE_CLIENT_SECRETS_FILE=
# Where the OAuth token gets cached after the first interactive login.
# Defaults to <repo root>/.youtube_token.json if unset.
YOUTUBE_TOKEN_FILE=
